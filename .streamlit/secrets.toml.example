# Copy to secrets.toml (gitignored), then replace every placeholder.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "GENERATE-A-LONG-RANDOM-SECRET"
client_id = "YOUR-OIDC-CLIENT-ID"
client_secret = "YOUR-OIDC-CLIENT-SECRET"
server_metadata_url = "YOUR-OIDC-DISCOVERY-URL"

[access]
instructor_emails = ["instructor@your-school.edu"]
